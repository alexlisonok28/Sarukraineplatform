# Netlify DB сама додає NETLIFY_DATABASE_URL після `npx netlify db init`.
# Не копіюйте URL бази у frontend та не додавайте його до VITE_* змінних.

# Єдина змінна, яку потрібно створити вручну в Netlify:
# згенерувати командою: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes

# Необов'язково. Frontend за замовчуванням звертається до /api.
# VITE_API_URL=http://localhost:8888/api
